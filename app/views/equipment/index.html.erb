<% content_for :title, "Equipment · Climbing Gear Rental" %>

<% content_for :hero do %>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-inner">
      <div>
        <h1 id="hero-title">Rent climbing gear by the hour.</h1>
        <p>Ropes, harnesses, belay devices and more. Every return gets an inspection before the next climber.</p>
      </div>
      <%= link_to "Add equipment", new_equipment_path, class: "button button-secondary" %>
    </div>
  </section>
<% end %>

<% if @equipment.any? %>
  <ul class="gear-grid" role="list">
    <% @equipment.each do |item| %>
      <li>
        <article class="gear-card" id="equipment_<%= item.public_id %>">
          <%= render "equipment/image", equipment: item %>
          <div class="gear-card-body">
            <h2 class="gear-card-title">
              <%= link_to item.name, equipment_path(item), class: "stretched-link" %>
            </h2>
            <%= render "equipment/gauge", free: item.units_free_at, capacity: item.capacity %>
            <p class="hint"><%= turnaround_note(item.turnaround_minutes) %></p>
          </div>
        </article>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No gear yet. <%= link_to "Add the first piece", new_equipment_path %>.</p>
<% end %>
