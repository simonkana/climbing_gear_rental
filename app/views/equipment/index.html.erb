<% content_for :title, "Equipment · Climbing Gear Rental" %>

<h1>Equipment</h1>

<% if @equipment.any? %>
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Capacity</th>
          <th scope="col">Free now</th>
          <th scope="col">Turnaround</th>
        </tr>
      </thead>
      <tbody>
        <% @equipment.each do |item| %>
          <tr id="equipment_<%= item.public_id %>">
            <td><%= link_to item.name, equipment_path(item) %></td>
            <td class="capacity"><%= item.capacity %></td>
            <td class="free-now"><%= item.units_free_at %></td>
            <td><%= item.turnaround_minutes %> min</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No equipment yet.</p>
<% end %>
