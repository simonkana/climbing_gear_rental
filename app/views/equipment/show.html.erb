<% content_for :title, "#{@equipment.name} · Climbing Gear Rental" %>

<h1><%= @equipment.name %></h1>
<% if @equipment.description.present? %>
  <p><%= @equipment.description %></p>
<% end %>

<dl class="facts">
  <dt>Capacity</dt>
  <dd><%= pluralize(@equipment.capacity, "unit") %></dd>
  <dt>Turnaround</dt>
  <dd><%= @equipment.turnaround_minutes %> min after each rental (inspection and cleaning)</dd>
  <dt>Free now</dt>
  <dd><%= @equipment.units_free_at %></dd>
</dl>

<section id="upcoming-reservations" aria-labelledby="upcoming-heading">
  <h2 id="upcoming-heading">Upcoming reservations</h2>
  <% if @upcoming.any? %>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th scope="col">From</th>
            <th scope="col">To</th>
            <th scope="col">Blocked until</th>
          </tr>
        </thead>
        <tbody>
          <% @upcoming.each do |reservation| %>
            <tr id="reservation_<%= reservation.public_id %>">
              <td><%= l reservation.start_date %></td>
              <td><%= l reservation.end_date %></td>
              <td><%= l reservation.blocked_until %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>No upcoming reservations.</p>
  <% end %>
</section>

<% if @past.any? %>
  <details id="past-reservations">
    <summary>Past and cancelled reservations (<%= @past.size %>)</summary>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th scope="col">From</th>
            <th scope="col">To</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @past.each do |reservation| %>
            <tr id="reservation_<%= reservation.public_id %>">
              <td><%= l reservation.start_date %></td>
              <td><%= l reservation.end_date %></td>
              <td><%= reservation.cancelled? ? "Cancelled" : "Finished" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </details>
<% end %>
